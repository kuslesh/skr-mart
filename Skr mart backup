function saveProduct(id){

let p={

id:id||Date.now(),

name:document.getElementById("pn").value.trim(),

price:Number(document.getElementById("pp").value),

old:Number(document.getElementById("po").value)||0,

stock:Number(document.getElementById("ps").value)||0,

emoji:document.getElementById("pe").value||"📦",

image:document.getElementById("pi").value.trim()

};


if(!p.name||!p.price){

alert("Product name और price जरूरी है.");

return;

}


if(id){

let index=db.products.findIndex(x=>x.id===id);

db.products[index]=p;

}else{

db.products.push(p);

}


save();

closeModal();

renderProducts();

renderAdmin();

}


function deleteProduct(id){

if(confirm("Product delete करें?")){

db.products=db.products.filter(p=>p.id!==id);

save();

renderProducts();

renderAdmin();

}

}


